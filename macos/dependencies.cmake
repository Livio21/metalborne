include(FetchContent)
set(ARCHITECTURE x86_64)
set(BUILD_SHARED_LIBS OFF CACHE BOOL "" FORCE)
set(BUILD_TESTING OFF CACHE BOOL "" FORCE)
function(bb_dependency name repository revision)
    FetchContent_Declare(${name}
        URL "https://codeload.github.com/${repository}/tar.gz/${revision}"
        DOWNLOAD_EXTRACT_TIMESTAMP TRUE TIMEOUT 120 INACTIVITY_TIMEOUT 20)
    FetchContent_MakeAvailable(${name})
    FetchContent_GetProperties(${name} SOURCE_DIR dependency_source)
    set(${name}_SOURCE_DIR "${dependency_source}" PARENT_SCOPE)
endfunction()
